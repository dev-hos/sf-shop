{% extends 'base.html.twig' %}

{% block title %}
  Boutique{% endblock %}

{% block body %}
  <h1 class="text-3xl font-bold tracking-tight">Nos produits</h1>

  <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {% for product in products %}
      <twig:Card>
        <twig:Card:Header>
          <twig:Card:Title>
            <a href="{{ path('app_product_show', {slug: product.slug}) }}" class="hover:underline">
              {{ product.name }}
            </a>
          </twig:Card:Title>
          <twig:Card:Description>{{ product.price.format() }}</twig:Card:Description>
        </twig:Card:Header>
        <twig:Card:Footer>
          <twig:Button class="w-full">Ajouter au panier</twig:Button>
        </twig:Card:Footer>
      </twig:Card>
    {% endfor %}
  </div>
{% endblock %}
