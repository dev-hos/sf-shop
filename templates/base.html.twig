<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Shop{% endblock %}</title>
    {% block stylesheets %}
    {% endblock %}
    <script>
      try {
        const stored = localStorage.getItem("theme");
        const dark = stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      } catch (e) {}
    </script>
    {% block javascripts %}
      {% block importmap %}
        {{ importmap('app') }}{% endblock %}
    {% endblock %}
  </head>
  <body class="flex min-h-screen flex-col antialiased">
    <header class="sticky top-0 z-40 border-b bg-background/80 backdrop-blur">
      <div class="mx-auto flex h-14 w-full max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
        <a href="{{ path('app_home') }}" class="font-semibold tracking-tight">Shop</a>
        <nav class="flex items-center gap-6 text-sm text-muted-foreground">
          <a href="{{ path('app_home') }}" class="transition-colors hover:text-foreground">Produits</a>
          <a href="#" class="transition-colors hover:text-foreground">Panier</a>
          <twig:Button
            variant="ghost"
            size="icon"
            data-controller="theme"
            data-action="click->theme#toggle"
            aria-label="Changer de thème">
            <twig:ux:icon name="lucide:moon" class="size-4 dark:hidden" />
            <twig:ux:icon name="lucide:sun" class="hidden size-4 dark:block" />
          </twig:Button>
        </nav>
      </div>
    </header>

    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-10 sm:px-6 lg:px-8">
      {% block body %}
      {% endblock %}
    </main>

    <footer class="border-t py-6 text-center text-sm text-muted-foreground">
      © {{ 'now'|date('Y') }} Shop
    </footer>
  </body>
</html>
