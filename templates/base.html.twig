<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Shop{% endblock %}</title>
    {% block stylesheets %}
    {% endblock %}
    {% block javascripts %}
      {% block importmap %}
        {{ importmap('app') }}{% endblock %}
    {% endblock %}
  </head>
  <body class="flex min-h-screen flex-col bg-white text-neutral-900 antialiased">
    <header class="sticky top-0 z-40 border-b bg-white/80 backdrop-blur">
      <div class="mx-auto flex h-14 w-full max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
        <a href="{{ path('app_home') }}" class="font-semibold tracking-tight">Shop</a>
        <nav class="flex items-center gap-6 text-sm text-neutral-600">
          <a href="{{ path('app_home') }}" class="transition-colors hover:text-neutral-900">Produits</a>
          <a href="#" class="transition-colors hover:text-neutral-900">Panier</a>
        </nav>
      </div>
    </header>

    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-10 sm:px-6 lg:px-8">
      {% block body %}
      {% endblock %}
    </main>

    <footer class="border-t py-6 text-center text-sm text-neutral-500">
      © {{ 'now'|date('Y') }} Shop
    </footer>
  </body>
</html>
